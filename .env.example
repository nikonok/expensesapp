# ─── Build-time (frontend, baked into Vite bundle) ──────────────────────────

# Phase 1 — Google Sign-In (frontend)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Phase 9 — Web Push (frontend)
VITE_VAPID_PUBLIC_KEY=

# ─── Runtime (docker-compose / server .env) ─────────────────────────────────
# These are written to the server's .env by .github/workflows/deploy.yml from
# GitHub Secrets. They must all be present, or `docker compose up` fails with
# a `:?required` error from docker-compose.yml.

# Cloudflare Tunnel token (from Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Phase 1 — Backend bootstrap admin
# OPERATOR MUST change this to a real Google account email before deploying.
# The first sign-in with this address is promoted to root.
BOOTSTRAP_ADMIN_EMAIL=root@example.com

# Phase 1 — Google Sign-In (backend)
GOOGLE_OAUTH_CLIENT_ID=your.apps.googleusercontent.com

# Phase 9 — Web Push (backend)
# Generate with: docker run --rm node:alpine npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
