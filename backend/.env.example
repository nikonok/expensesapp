# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ──────────── Server ────────────
BIND_ADDR=:8080
LOG_LEVEL=info
DB_PATH=./data.db

# ──────────── Auth ────────────
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ──────────── Web Push / VAPID ────────────
# Generate keys once with: go run github.com/SherClockHolmes/webpush-go/example/keygen
# or use: webpush.GenerateVAPIDKeys() in a small Go main.
# When any of these is empty, push delivery is disabled but subscription
# endpoints still function.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URI per RFC 8292 §2.1
VAPID_SUBJECT=mailto:admin@example.com
